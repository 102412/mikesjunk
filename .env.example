# Public iOS build settings; supply through Xcode user-defined settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server-side only: supabase secrets set --env-file .env
GROQ_API_KEY=
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
# Optional provider: brave. Omit for internal-only research.
WEB_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
RESEARCH_DAILY_LIMIT=30
RESEARCH_MAX_TOKENS=1200
