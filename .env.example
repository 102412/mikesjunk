# Optional: enables the server-side project-aware AI assistant.
# Never prefix this variable with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Browser-safe Supabase values. Never put a service-role key in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only self-hosted Activepieces runtime. Never expose either value to
# the browser and never store third-party OAuth tokens in Supabase.
ACTIVEPIECES_API_URL=
ACTIVEPIECES_API_KEY=

# Server-only Google Calendar OAuth credentials. The callback must be listed in
# Google Cloud as an Authorized redirect URI. Never expose any of these to the browser.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
# Generate a 32-byte random value and encode it as base64.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# Used only by server routes to store ciphertext. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: authenticated HTTPS URL of your separately hosted Chromium desktop.
# Public address only; never include credentials or access tokens.
NEXT_PUBLIC_BROWSER_DESKTOP_URL=
